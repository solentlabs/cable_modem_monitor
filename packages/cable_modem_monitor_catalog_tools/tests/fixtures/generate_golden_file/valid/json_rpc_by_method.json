{
  "_description": "JSON-RPC capture: resources are keyed by method, each the call's result; the later result wins",
  "_transport": "json_rpc",
  "_parser_yaml": "downstream:\n  format: json\n  resource: \"CM.getDownstream\"\n  arrays:\n    - array_path: \"dss\"\n      channel_type:\n        fixed: \"qam\"\n      fields:\n        - key: \"channel\"\n          field: channel_id\n          type: integer\n        - key: \"frequency\"\n          field: frequency\n          type: frequency\n",
  "_har": {
    "log": {
      "entries": [
        {
          "request": {
            "url": "https://192.168.0.1/cgi-bin/router.php?token=FIELD_t",
            "method": "POST",
            "postData": {
              "mimeType": "application/json",
              "text": "{\"jsonrpc\": \"2.0\", \"method\": \"CM.getDownstream\", \"params\": [], \"id\": 1}"
            }
          },
          "response": {
            "status": 200,
            "content": {
              "mimeType": "application/json",
              "text": "{\"jsonrpc\": \"2.0\", \"result\": {\"dss\": [{\"channel\": \"1\", \"frequency\": \"490000000\"}]}, \"id\": 1}"
            }
          }
        },
        {
          "request": {
            "url": "https://192.168.0.1/cgi-bin/router.php?token=FIELD_t",
            "method": "POST",
            "postData": {
              "mimeType": "application/json",
              "text": "{\"jsonrpc\": \"2.0\", \"method\": \"CM.getDownstream\", \"params\": [], \"id\": 1}"
            }
          },
          "response": {
            "status": 200,
            "content": {
              "mimeType": "application/json",
              "text": "{\"jsonrpc\": \"2.0\", \"result\": {\"dss\": [{\"channel\": \"2\", \"frequency\": \"498000000\"}]}, \"id\": 1}"
            }
          }
        }
      ]
    }
  },
  "_expected_channel_counts": {
    "downstream": 1,
    "upstream": 0
  },
  "_expected_system_info_fields": [
    "downstream_channel_count",
    "upstream_channel_count"
  ],
  "_expected_missing_system_info_fields": [
    "docsis_status",
    "hardware_version",
    "software_version",
    "system_uptime"
  ],
  "_expected_golden_file": {
    "downstream": [
      {
        "channel_id": 2,
        "channel_number": 1,
        "frequency": 498000000,
        "channel_type": "qam"
      }
    ],
    "upstream": [],
    "system_info": {
      "downstream_channel_count": 1,
      "upstream_channel_count": 0
    }
  }
}
